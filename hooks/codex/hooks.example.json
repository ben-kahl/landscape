{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$LANDSCAPE_HOME/scripts/landscape_capture_hook.py\" codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$LANDSCAPE_HOME/scripts/landscape_capture_hook.py\" codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
